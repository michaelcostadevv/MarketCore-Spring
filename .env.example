# Copie este arquivo para .env e troque os valores.
# O .env está no .gitignore e nunca deve ser commitado.

MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MARKETCORE_DB_NAME=marketcore_db
MARKETCORE_DB_USER=marketcore
MARKETCORE_DB_PASSWORD=troque-esta-senha

# Mínimo de 32 caracteres. Gere um com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Administrador criado na primeira inicialização (opcional)
ADMIN_EMAIL=admin@marketcore.com
ADMIN_PASSWORD=troque-esta-senha-admin
